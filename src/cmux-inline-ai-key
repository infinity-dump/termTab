#!/bin/zsh
set -euo pipefail

provider="${1:-openrouter}"
case "$provider" in
  openrouter|anthropic|openai) ;;
  *)
    print -u2 "Usage: cmux-inline-ai-key [openrouter|anthropic|openai]"
    exit 2
    ;;
esac

print -n "Paste $provider API key: " > /dev/tty
stty -echo < /dev/tty
IFS= read -r key < /dev/tty
stty echo < /dev/tty
print "" > /dev/tty

if [[ -z "$key" ]]; then
  print -u2 "No key provided."
  exit 1
fi

security add-generic-password -a "$USER" -s "cmux-inline-ai-$provider" -w "$key" -U >/dev/null
print "Stored $provider key in macOS Keychain service cmux-inline-ai-$provider."
